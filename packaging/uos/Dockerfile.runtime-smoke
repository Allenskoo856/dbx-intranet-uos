FROM ubuntu:22.04

ARG DEB_FILE
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      dpkg \
      libwebkit2gtk-4.1-0 \
      libgtk-3-0 \
      libayatana-appindicator3-1 \
    && rm -rf /var/lib/apt/lists/*

COPY ${DEB_FILE} /tmp/dbx-offline.deb
RUN dpkg -i /tmp/dbx-offline.deb \
    && rm -f /tmp/dbx-offline.deb

ENTRYPOINT ["/usr/bin/dbx"]
